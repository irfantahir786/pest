<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Indian Motor Insurance Policy Extractor</h1>
      <p class="subtitle">Upload your motor insurance policy document to extract structured data</p>
    </header>

    <main>
      <section class="upload-section">
        <form id="uploadForm" enctype="multipart/form-data">
          <div class="file-input-wrapper">
            <label for="fileInput" class="file-label">
              <span class="file-icon">📄</span>
              <span id="fileText">Click to select or drag & drop PDF/Image</span>
            </label>
            <input type="file" id="fileInput" name="file" accept=".pdf,.jpg,.jpeg,.png" required>
          </div>
          
          <div id="fileInfo" class="file-info" style="display: none;">
            <p><strong>Filename:</strong> <span id="fileName"></span></p>
            <p><strong>Type:</strong> <span id="fileType"></span></p>
            <p><strong>Size:</strong> <span id="fileSize"></span></p>
          </div>

          <button type="submit" id="extractBtn" class="btn-primary">
            <span class="btn-text">Extract Data</span>
            <span class="btn-loading" style="display: none;">Processing...</span>
          </button>
        </form>

        <div id="statusMessage" class="status-message" style="display: none;"></div>
      </section>

      <section id="resultSection" class="result-section" style="display: none;">
        <h2>Extraction Results</h2>
        
        <div class="extraction-meta">
          <div class="meta-item">
            <strong>Method:</strong> <span id="extractionMethod"></span>
          </div>
          <div class="meta-item">
            <strong>Confidence:</strong> <span id="extractionConfidence"></span>
          </div>
          <div class="meta-item">
            <strong>Pages:</strong> <span id="extractionPages"></span>
          </div>
        </div>

        <div class="tabs">
          <button class="tab-btn active" data-tab="structured">Structured Data</button>
          <button class="tab-btn" data-tab="raw">Raw Text</button>
        </div>

        <div id="structuredTab" class="tab-content active">
          <div id="structuredData" class="data-container"></div>
        </div>

        <div id="rawTab" class="tab-content">
          <pre id="rawText" class="raw-text"></pre>
        </div>

        <div id="warningsSection" class="warnings-section" style="display: none;">
          <h3>Warnings</h3>
          <ul id="warningsList"></ul>
        </div>
      </section>
    </main>

    <footer>
      <p>Supports policies from all major Indian insurance companies</p>
    </footer>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
